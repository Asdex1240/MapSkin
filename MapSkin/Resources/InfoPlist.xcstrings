    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MapSkin uses your location in the background to keep guiding you while navigation is active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MapSkin usa tu ubicación en segundo plano para seguir guiándote mientras la navegación está activa."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "MapSkin uses your location to show where you are on the map and to guide you to your destination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MapSkin usa tu ubicación para mostrarte dónde estás en el mapa y guiarte a tu destino."
