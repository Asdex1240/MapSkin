    "about.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location never leaves your device except to search places and calculate routes with Apple's services. MapSkin has no accounts and no ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación nunca sale de tu dispositivo, salvo para buscar lugares y calcular rutas con los servicios de Apple. MapSkin no tiene cuentas ni anuncios."
          }
        }
      }
    },
