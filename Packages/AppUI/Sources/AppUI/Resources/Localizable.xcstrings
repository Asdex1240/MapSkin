    "texturePacks.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a .mapskin or .zip file, or a folder, from Files. Create Your Pack shares an empty template with every file you need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un archivo .mapskin o .zip, o una carpeta, desde Archivos. Crear tu paquete comparte una plantilla vacía con todos los archivos que necesitas."
          }
        }
      }
    },
